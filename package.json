{
  "name": "night-identifier-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && uv run uvicorn app.main:app --host 127.0.0.1 --port 8765 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "typecheck": "cd frontend && npm run typecheck",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
